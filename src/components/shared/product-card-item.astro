---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  badge: string;
  title: string;
  subtitle: string;
  applications?: string[];
  keyFeatures?: Array<{ name: string; rating: number }>;
  specifications?: Array<{ label: string; value: string }>;
  image: ImageMetadata;
  badgeColor?: string;
}

const {
  badge,
  title,
  subtitle,
  applications = [],
  keyFeatures = [],
  specifications = [],
  image,
  badgeColor = "var(--color-primary)"
} = Astro.props;

// Show only top 3 features by rating for visual alignment
const maxRating = 6;
const topFeatures = [...keyFeatures].sort((a, b) => b.rating - a.rating).slice(0, 3);
---

<div class="bg-white rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-border)] transition-all duration-300 cursor-pointer hover:shadow-xl hover:-translate-y-1 hover:border-transparent">
  <!-- Product image -->
  <div class="h-[240px] overflow-hidden relative">
    <Image
      src={image}
      alt={`${title} - ${subtitle}`}
      width={600}
      height={240}
      class="w-full h-full object-cover"
      format="webp"
    />
    <span
      class="absolute top-4 left-4 text-white px-3 py-[6px] rounded-full text-[11px] font-semibold uppercase tracking-[0.05em]"
      style={`background: ${badgeColor}`}
    >
      {badge}
    </span>
  </div>

  <div class="p-6">
    <h3 class="text-xl font-semibold mb-1 tracking-[-0.01em]">{title}</h3>
    <p class="text-sm text-[var(--color-text-muted)] mb-4">{subtitle}</p>

    {/* Applications */}
    {applications.length > 0 && (
      <div class="mb-4">
        <h4 class="text-xs font-semibold uppercase tracking-[0.05em] text-slate-500 mb-2">Applications</h4>
        <div class="flex flex-wrap gap-1.5">
          {applications.map((app) => (
            <span class="text-xs px-2.5 py-1 bg-slate-100 text-slate-600 rounded-full">{app}</span>
          ))}
        </div>
      </div>
    )}

    {/* Key features with rating dots */}
    {keyFeatures.length > 0 && (
      <div class="mb-4">
        <h4 class="text-xs font-semibold uppercase tracking-[0.05em] text-slate-500 mb-2">Key Features</h4>
        <ul class="space-y-1.5">
          {topFeatures.map((feature) => (
            <li class="flex items-center justify-between text-xs">
              <span class="text-slate-600">{feature.name}</span>
              <span class="flex gap-0.5">
                {Array.from({ length: maxRating }).map((_, i) => (
                  <span class={`w-2 h-2 rounded-full ${i < feature.rating ? 'bg-[var(--color-primary)]' : 'bg-slate-200'}`}></span>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <a href="#contact" class="w-full px-6 py-3 font-sans text-sm font-semibold rounded-sm transition-all duration-200 cursor-pointer border-none inline-flex items-center justify-center gap-2 bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-dark)] hover:-translate-y-px hover:shadow-lg">
      Get Quote
    </a>
  </div>
</div>
